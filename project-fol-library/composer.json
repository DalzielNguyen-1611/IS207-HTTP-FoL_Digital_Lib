{
    "name": "fol/library-system",
    "description": "Faculty of Literature (FoL) Digital Library Management System - Khoa Văn học (IS207)",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Nhóm Đồ Án IS207.R11",
            "email": "24520500@gm.uit.edu.vn"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "Tests\\": "tests/"
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "test": "php tests/run_all_tests.php",
        "test:all": "php tests/run_all_tests.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
