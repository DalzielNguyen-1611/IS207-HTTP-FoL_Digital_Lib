APP_NAME="FoL Digital Library"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE="Asia/Ho_Chi_Minh"

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fol_library_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session & Security
SESSION_LIFETIME=120
SESSION_COOKIE_NAME=fol_lib_session
APP_KEY=base64:FoLDigitalLibrarySecretKey2026IS207==

# Storage & Uploads
UPLOAD_MAX_FILESIZE=10M
UPLOAD_PATH=storage/uploads/
LOG_PATH=storage/logs/

# Google OAuth 2.0 Configuration (OpenID Connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_STUDENT_DOMAINS=gm.uit.edu.vn,sv.ussh.edu.vn
GOOGLE_ADMIN_EMAILS=
